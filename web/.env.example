# Base URL of the FastAPI backend (docs/contracts/api.md). Used only when NEXT_PUBLIC_API_MODE=live.
NEXT_PUBLIC_API_URL=http://localhost:8000

# mock = in-memory fixtures (no backend needed) · live = real API
NEXT_PUBLIC_API_MODE=mock

# Passcode accepted by the mock login. In live mode the backend validates the passcode.
NEXT_PUBLIC_MOCK_PASSCODE=larkspur-demo
