# Copy to .env and fill in. Never commit .env.

# --- LLM (agent) ---
# Default: a free open-weight model served locally by Ollama (OpenAI-compatible API).
#   ollama pull qwen2.5:14b
# Other free/open options use the same adapter: lmstudio, openrouter, groq, huggingface,
# or openai_compat + LLM_BASE_URL for vLLM / llama.cpp. "anthropic" is also supported.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:14b           # must support native tool calling
LLM_BASE_URL=                   # blank = provider default (ollama: http://localhost:11434/v1)
LLM_API_KEY=                    # not needed for local servers; required for hosted free tiers
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_S=300               # local models on a laptop GPU can be slow
# Anthropic-only settings (ignored by open-model providers):
LLM_EFFORT=medium
LLM_FALLBACKS=default

# --- LLM (user simulator for evals) ---
SIM_LLM_PROVIDER=ollama
SIM_LLM_MODEL=qwen2.5:14b       # same model avoids swapping models in 6 GB of VRAM
SIM_LLM_BASE_URL=
SIM_LLM_API_KEY=
SIM_LLM_TEMPERATURE=0.7         # a little variety in simulated customers

# --- Database ---
DATABASE_URL=postgresql+psycopg://psa:psa@localhost:5433/psa

# --- Stripe (TEST MODE ONLY: must start with sk_test_) ---
STRIPE_SECRET_KEY=sk_test_replace_me   # placeholder => built-in stripe-sim; sk_live_ aborts startup

# --- Observability (optional) ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=policy-safe-action-agent

# --- App ---
APP_AUTH_SECRET=change-me-to-32-plus-random-characters
DEMO_PASSCODE=change-me

# --- Web (web/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_MODE=mock       # mock | live
