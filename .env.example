# Copy to .env and fill in. Never commit .env.

# --- LLM (agent) ---
LLM_PROVIDER=anthropic          # anthropic | openai
LLM_MODEL=                      # provider model ID; never hardcoded in code
LLM_API_KEY=

# --- LLM (user simulator for evals) ---
SIM_LLM_PROVIDER=anthropic
SIM_LLM_MODEL=
SIM_LLM_API_KEY=

# --- Database ---
DATABASE_URL=postgresql+psycopg://psa:psa@localhost:5432/psa

# --- Stripe (TEST MODE ONLY: must start with sk_test_) ---
STRIPE_SECRET_KEY=sk_test_replace_me

# --- Observability (optional) ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=policy-safe-action-agent

# --- App ---
APP_AUTH_SECRET=change-me-to-32-plus-random-characters
DEMO_PASSCODE=change-me

# --- Web (web/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_MODE=mock       # mock | live
