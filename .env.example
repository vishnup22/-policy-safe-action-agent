# Copy to .env and fill in. Never commit .env.

# --- LLM (agent) ---
LLM_PROVIDER=anthropic          # only "anthropic" is implemented today
LLM_MODEL=claude-opus-5-5       # provider model ID; never hardcoded in code
LLM_API_KEY=                    # optional if `ant auth login` / ANTHROPIC_API_KEY is set
LLM_EFFORT=medium               # low | medium | high | xhigh | max
LLM_FALLBACKS=default           # server-side refusal fallbacks: default | off

# --- LLM (user simulator for evals) ---
SIM_LLM_PROVIDER=anthropic
SIM_LLM_MODEL=claude-opus-5-5
SIM_LLM_API_KEY=
SIM_LLM_EFFORT=low              # the simulated customer needs little reasoning

# --- Database ---
DATABASE_URL=postgresql+psycopg://psa:psa@localhost:5433/psa

# --- Stripe (TEST MODE ONLY: must start with sk_test_) ---
STRIPE_SECRET_KEY=sk_test_replace_me   # placeholder => built-in stripe-sim; sk_live_ aborts startup

# --- Observability (optional) ---
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=policy-safe-action-agent

# --- App ---
APP_AUTH_SECRET=change-me-to-32-plus-random-characters
DEMO_PASSCODE=change-me

# --- Web (web/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_MODE=mock       # mock | live
